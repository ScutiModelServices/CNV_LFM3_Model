# Copy to .env (git-ignored). Docker compose reads it from this folder; run.bat reads the real environment.

# Admin password: unlocks /admin/, where you create a token per project; callers send theirs as X-Internal-Token.
# Empty = no auth at all (local use only).
LFM3_ADMIN_PASSWORD=

# Port the service listens on (compose: the port published by the load balancer).
LFM3_PORT=9170

# Compose only: API copies behind nginx. Each copy holds the model in RAM (about 5 GB).
LFM3_REPLICAS=1
# LFM3_MEM_LIMIT=7g

# Answer through an Ollama server (quantised GGUF, about 15x faster than torch on a CPU without AVX2) instead of
# running the model in this process. Thinking is turned off. From Docker, an Ollama on the host is
# http://host.docker.internal:11434 (Ollama must listen on 0.0.0.0). Pull the model there first: ollama pull <model>
# LFM3_OLLAMA_URL=http://host.docker.internal:11434
# LFM3_OLLAMA_MODEL=hf.co/LiquidAI/LFM3-1.7B-GGUF:Q4_K_M

# CPU threads for generation (torch decides when unset). A value saved on the /admin/ page beats this one.
# LFM3_NUM_THREAD=4

# Tunables (update check hours, in-flight cap, answers kept, project models, base model, load at start) are set on the /admin/
# Settings card and saved in settings.json. These variables are only a starting value for run.bat; compose does not
# pass them. A saved value wins.
# LFM3_UPDATE_CHECK_HOURS=6
# LFM3_MAX_INFLIGHT=
# LFM3_MAX_PROJECT_MODELS=2
# LFM3_PROJECT_MODELS_DIR=
# LFM3_MODEL=LiquidAI/LFM3-1.7B
# LFM3_DTYPE=bfloat16
# LFM3_WARM=1

# run.bat only (compose sets these itself): bind address.
# LFM3_HOST=127.0.0.1
# Where project tokens are stored (hashed) and the admin page folder. Docker sets /data/tokens.json and /app/web.
# LFM3_TOKENS_FILE=tokens.json
# LFM3_WEB_DIR=web
